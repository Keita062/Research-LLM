{
  "name": "research-llm-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.1",
    "@google/genai": "^2.31.0",
    "@hono/node-server": "^2.1.5",
    "google-auth-library": "^10.9.1",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^3.2.0",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "@types/node": "^20.17.0"
  }
}
