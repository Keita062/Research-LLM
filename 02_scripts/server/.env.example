# ローカル開発用。コピーして .env を作る（.env はコミットしない）
PORT=8080
# memory（ローカル・テスト）または firestore（本番）
STORE=memory
# 未設定なら LLM はモック応答になる（ローカル確認用）
GEMINI_API_KEY=
# 管理画面にログインできる Google アカウント（カンマ区切り）
ADMIN_EMAILS=
# Google OAuth クライアント（管理画面ログイン用）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 公開URL（OAuth のリダイレクトURI生成に使用）
PUBLIC_URL=http://localhost:8080
# Cookie 署名鍵（32文字以上のランダム文字列）
SESSION_SECRET=change-me-change-me-change-me-change-me
# 1 にするとローカル専用の簡易ログイン（メールアドレス入力のみ）を有効化。NODE_ENV=production では無効
ADMIN_DEV_LOGIN=1
