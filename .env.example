# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/research_llm?schema=public"

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Resend (https://resend.com/api-keys)
# EMAIL_MODE=console の間は実際には送信されず、リンクがサーバーログに出力される。
# APIキー取得後、EMAIL_MODE=resend に切り替えると実メール送信になる。
EMAIL_MODE="console"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Lab Chatbot <onboarding@resend.dev>"

# Sessions
SESSION_COOKIE_NAME="lab_chatbot_session"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate limit seed defaults (prisma/seed.ts で RateLimitConfig の初期値として使用。
# 以降は管理画面 /admin/usage から変更する。
# 重要: Gemini無料枠の実際の数値は変動するため、必ず https://aistudio.google.com/rate-limit で確認し、
# 安全マージンを見て（例: 実際の枠の8割程度に）設定すること。)
RATE_LIMIT_GLOBAL_RPM=8
RATE_LIMIT_GLOBAL_TPM=200000
RATE_LIMIT_GLOBAL_RPD=200
RATE_LIMIT_USER_DAILY_REQUESTS=30
RATE_LIMIT_USER_DAILY_TOKENS=20000

# First-admin bootstrap (prisma/seed.ts でのみ使用)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Lab Admin"
